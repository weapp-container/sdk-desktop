@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(UNIX AND NOT APPLE)
  find_dependency(PkgConfig)
  pkg_check_modules(GTK3 REQUIRED IMPORTED_TARGET gtk+-3.0>=3.24 gio-2.0>=2.66 fontconfig epoxy)
  if(@WEAPP_DESKTOP_USES_CURL@)
    find_dependency(CURL @WEAPP_DESKTOP_CURL_MIN_VERSION@)
  endif()
endif()
if(NOT TARGET WeappContainer::Core)
  if(WIN32)
    add_library(WeappContainer::Core SHARED IMPORTED)
    set_target_properties(WeappContainer::Core PROPERTIES
      IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@WEAPP_CORE_FILE@"
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/@WEAPP_CORE_RUNTIME_FILE@"
      INTERFACE_COMPILE_DEFINITIONS WEAPP_CONTAINER_SDK_SHARED)
  else()
    add_library(WeappContainer::Core STATIC IMPORTED)
    set_target_properties(WeappContainer::Core PROPERTIES IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@WEAPP_CORE_FILE@")
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/WeappContainerDesktopTargets.cmake")
function(weapp_container_copy_runtime target)
  if(WIN32)
    add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "$<TARGET_FILE:WeappContainer::Core>" "$<TARGET_FILE_DIR:${target}>" VERBATIM)
  endif()
endfunction()
check_required_components(WeappContainerDesktop)
