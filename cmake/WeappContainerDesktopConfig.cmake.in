@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(UNIX AND NOT APPLE)
  find_dependency(PkgConfig)
  pkg_check_modules(GTK3 REQUIRED IMPORTED_TARGET gtk+-3.0>=3.24 gio-2.0>=2.66 fontconfig epoxy)
  if(@WEAPP_DESKTOP_USES_CURL@)
    find_dependency(CURL 7.85)
  endif()
endif()
if(NOT TARGET WeappContainer::Core)
  add_library(WeappContainer::Core STATIC IMPORTED)
  set_target_properties(WeappContainer::Core PROPERTIES IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@WEAPP_CORE_FILE@")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/WeappContainerDesktopTargets.cmake")
check_required_components(WeappContainerDesktop)
